MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.5o19og2.mongodb.net/?compressors=zlib

# Envio de e-mail (confirmação de cadastro, recuperação de senha, troca de
# e-mail e formulário de contato). Sem nada configurado, os códigos aparecem
# na própria resposta da API (modo demonstração). Ver docs/backend.md, seção 14.

# Recomendado: API HTTPS da Brevo (funciona mesmo em redes que bloqueiam SMTP).
# BREVO_API_KEY=xkeysib-...

# Para onde vão as mensagens do formulário de contato (padrão: SMTP_FROM).
# CONTATO_EMAIL=equipe@exemplo.com

# Alternativa: SMTP comum (SMTP_FROM também é o remetente da Brevo).
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario@exemplo.com
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@labielos.local
